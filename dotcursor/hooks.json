{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "$HOME/.cursor/hooks/garde-fou.py",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": "$HOME/.cursor/hooks/garde-fou.py",
        "matcher": "Write|Delete|StrReplace",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "sessionStart": [
      {
        "command": "node \"$HOME/Documents/ponytail/hooks/ponytail-activate.js\"",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"$HOME/Documents/ponytail/hooks/ponytail-mode-tracker.js\"",
        "timeout": 15
      }
    ]
  }
}
