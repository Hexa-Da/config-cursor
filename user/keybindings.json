[
    {
        "key": "ctrl+1",
        "command": "editor.action.blockComment",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+2",
        "command": "editor.action.indentLines",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+3",
        "command": "editor.action.outdentLines",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+4",
        "command": "editor.action.formatSelection",
        "when": "editorTextFocus && !editorReadonly && editorHasSelection"
    },
    {
        "key": "cmd+m",
        "command": "composerMode.chat",
        "when": "isMac"
    },
    {
        "key": "ctrl+m",
        "command": "composerMode.chat",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+shift+m",
        "command": "composerMode.agent",
        "when": "isMac"
    },
    {
        "key": "ctrl+shift+m",
        "command": "composerMode.agent",
        "when": "isLinux || isWindows"
    },
    {
        "key": "ctrl+shift+m",
        "command": "composerMode.plan",
        "when": "isMac"
    },
    {
        "key": "alt+shift+m",
        "command": "composerMode.plan",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+;",
        "command": "workbench.action.maximizeChatSize",
        "when": "isMac"
    },
    {
        "key": "ctrl+;",
        "command": "workbench.action.maximizeChatSize",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+[Period]",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "isMac"
    },
    {
        "key": "ctrl+[Period]",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+shift+g",
        "command": "workbench.view.scm",
        "when": "isMac"
    },
    {
        "key": "ctrl+shift+g",
        "command": "workbench.view.scm",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+g",
        "command": "-editor.action.nextMatchFindAction",
        "when": "isMac"
    },
    {
        "key": "ctrl+g",
        "command": "-editor.action.nextMatchFindAction",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+g",
        "command": "git.viewChanges",
        "when": "isMac"
    },
    {
        "key": "ctrl+g",
        "command": "git.viewChanges",
        "when": "isLinux || isWindows"
    },
    {
        "key": "ctrl+e",
        "command": "-cursor.toggleAgentWindowIDEUnification"
    },
    {
        "key": "cmd+e",
        "command": "-cursor.toggleAgentWindowIDEUnification"
    },
    {
        "key": "cmd+e",
        "command": "workbench.action.quickOpen",
        "when": "isMac"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.action.quickOpen",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+p",
        "command": "-workbench.action.quickOpen",
        "when": "isMac"
    },
    {
        "key": "ctrl+p",
        "command": "-workbench.action.quickOpen",
        "when": "isLinux || isWindows"
    }
]