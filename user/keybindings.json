[
    {
        "key": "ctrl+1",
        "command": "editor.action.blockComment",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "cmd+m",
        "command": "composerMode.chat",
        "when": "isMac"
    },
    {
        "key": "ctrl+m",
        "command": "composerMode.chat",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+shift+m",
        "command": "composerMode.agent",
        "when": "isMac"
    },
    {
        "key": "ctrl+shift+m",
        "command": "composerMode.agent",
        "when": "isLinux || isWindows"
    },
    {
        "key": "ctrl+shift+m",
        "command": "composerMode.plan",
        "when": "isMac"
    },
    {
        "key": "alt+shift+m",
        "command": "composerMode.plan",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+;",
        "command": "workbench.action.maximizeChatSize",
        "when": "isMac"
    },
    {
        "key": "ctrl+;",
        "command": "workbench.action.maximizeChatSize",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+alt+e",
        "command": "-workbench.action.maximizeChatSize"
    },
    {
        "key": "ctrl+alt+e",
        "command": "-workbench.action.maximizeChatSize"
    },
    {
        "key": "cmd+[Period]",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "isMac"
    },
    {
        "key": "ctrl+[Period]",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "isLinux || isWindows"
    },
    {
        "key": "cmd+shift+g",
        "command": "workbench.view.scm",
        "when": "isMac"
    },
    {
        "key": "ctrl+shift+g",
        "command": "workbench.view.scm",
        "when": "isLinux || isWindows"
    },
    {
        "key": "ctrl+e",
        "command": "-cursor.toggleAgentWindowIDEUnification"
    },
    {
        "key": "cmd+e",
        "command": "-cursor.toggleAgentWindowIDEUnification"
    },
    {
        "key": "cmd+e",
        "command": "workbench.action.quickOpen",
        "when": "isMac"
    },
    {
        "key": "ctrl+e",
        "command": "workbench.action.quickOpen",
        "when": "isLinux || isWindows"
    }
]
