{
    "workbench.iconTheme": "material-icon-theme",
    "files.autoSave": "afterDelay",
    "workbench.editor.showTabs": "multiple",
    "workbench.editorAssociations": {
        "*.pdf": "pdf.preview"
    },
    "cursor.composer.usageSummaryDisplay": "always",
    "window.autoDetectColorScheme": false,
    "window.restoreWindows": "none",
    "window.titleBarStyle": "native",
    "diffEditor.renderSideBySide": false,
    "cursor.composer.editorConversationDensity": "compact-ungrouped",
    "cursor.cpp.enablePartialAccepts": true,
    "git.autofetch": true,
    "git.openRepositoryInParentFolders": "never",
    "terminal.integrated.suggest.enabled": true,
    "window.menuBarVisibility": "compact",
    "diffEditor.ignoreTrimWhitespace": false,
    "kotlin.languageServer.enabled": false,
    "kotlin.debugAdapter.enabled": false,
    "cursor.composer.codeBlockWordWrap": true,
    "workbench.statusBar.visible": false,
    "workbench.agentsWindowButton.enabled": false,
    "workbench.editor.autoLockGroups": {
        "terminalEditor": false,
        "mainThreadWebview-browserPreview": false
    },
    "git.confirmSync": false
}
